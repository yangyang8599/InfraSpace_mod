<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>InfraSpaceProductionInsights</AssemblyName>
    <RootNamespace>InfraSpaceProductionInsights</RootNamespace>
    <GameManagedPath Condition="'$(GameManagedPath)' == ''">F:\SteamLibrary\steamapps\common\InfraSpace\InfraSpace_Data\Managed</GameManagedPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp" HintPath="$(GameManagedPath)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="DionicCore" HintPath="$(GameManagedPath)\DionicCore.dll" Private="false" />
    <Reference Include="DionicGame" HintPath="$(GameManagedPath)\DionicGame.dll" Private="false" />
    <Reference Include="InfraSpaceCore" HintPath="$(GameManagedPath)\InfraSpaceCore.dll" Private="false" />
    <Reference Include="old" HintPath="$(GameManagedPath)\old.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GameManagedPath)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(GameManagedPath)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(GameManagedPath)\Unity.TextMeshPro.dll" Private="false" />
  </ItemGroup>
</Project>
